# Base URL of your self-hosted FreeLLMAPI router (https://github.com/tashfeenahmed/freellmapi)
FREELLMAPI_BASE_URL=http://localhost:3001

# Unified API key from FreeLLMAPI's Keys page
FREELLMAPI_API_KEY=freellmapi-your-unified-key

# Port this app listens on
PORT=4000

# Max seconds to wait for a single agent before scoring it as failed
AGENT_TIMEOUT_SECONDS=25

# Longest question accepted by /api/chat (each one fans out to every agent)
MAX_MESSAGE_CHARS=4000

# Max JSON request body size accepted (any express/bytes-style size string)
JSON_BODY_LIMIT=64kb

# Per-IP rate limit on /api/chat: RATE_LIMIT_MAX runs per RATE_LIMIT_WINDOW_MS.
# In-memory and per process — resets on restart.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Set when running behind a reverse proxy / platform router so the rate limit
# is per client rather than one global bucket. A hop count, or any value
# express's "trust proxy" accepts ("loopback", an IP, a CIDR list).
#
# Leave BOTH of these unset for local dev and any directly-exposed deploy:
# with nothing in front of the process, trusting X-Forwarded-For just lets a
# client spoof its IP past the rate limiter.
#
# On Fly.io use 2, not 1 — Fly appends both the real client and the app's own
# anycast address, so X-Forwarded-For ends "..., <client>, <fly-app-ip>" and
# express counts hops in from the right. See the README.
# TRUST_PROXY=2

# Header holding a client IP that the platform OVERWRITES on every request
# (so, unlike X-Forwarded-For, a client can't seed it). Only consulted when
# TRUST_PROXY is also set. On Fly.io:
# CLIENT_IP_HEADER=Fly-Client-IP

# /api/health probes the router with GET /v1/models. The probe deadline is
# short so a hung router turns the check red quickly instead of holding the
# request open, and the result is cached so uptime monitors polling every
# 30s-5min cost at most one router request per TTL — the router's quota is
# shared with every other app pointed at it.
# ROUTER_PROBE_TIMEOUT_MS=4000
# ROUTER_HEALTH_TTL_MS=45000
