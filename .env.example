# Base URL of your self-hosted FreeLLMAPI router (https://github.com/tashfeenahmed/freellmapi)
FREELLMAPI_BASE_URL=http://localhost:3001

# Unified API key from FreeLLMAPI's Keys page
FREELLMAPI_API_KEY=freellmapi-your-unified-key

# Port this app listens on
PORT=4000

# Max seconds to wait for a single agent before scoring it as failed
AGENT_TIMEOUT_SECONDS=25

# Longest question accepted by /api/chat (each one fans out to every agent)
MAX_MESSAGE_CHARS=4000

# Max JSON request body size accepted (any express/bytes-style size string)
JSON_BODY_LIMIT=64kb

# Per-IP rate limit on /api/chat: RATE_LIMIT_MAX runs per RATE_LIMIT_WINDOW_MS.
# In-memory and per process — resets on restart.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Set when running behind a reverse proxy / platform router (e.g. Fly.io) so
# req.ip is the real client IP and rate limiting is per client, not global.
# A hop count (1) or any value express's "trust proxy" accepts. Leave unset
# when the app is directly exposed — trusting X-Forwarded-For otherwise lets
# a client spoof its IP past the rate limiter.
# TRUST_PROXY=1
